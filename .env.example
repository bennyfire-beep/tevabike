# ─── Supabase ─────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API

# Public keys (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only secret (NEVER expose to the client)
# Required for: rate limiting (bypasses RLS), admin user management
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Email — Resend (https://resend.com, free tier: 3k emails/month) ─────────
# Used for: monthly salary report sent to benny on 1st of each month
# Also set the FROM domain in Resend dashboard (or use onboarding@resend.dev for testing)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Cron security (Vercel auto-passes this in Authorization: Bearer header) ──
CRON_SECRET=generate-a-random-secret-here

# ─── WhatsApp / WATI (for automated attendance alerts) ───────────────────────
# Found in: app.wati.io → API → Access Token
WATI_API_URL=https://live-server-XXXXX.wati.io
WATI_API_TOKEN=your-wati-bearer-token-here

# ─── WhatsApp Cloud API (the live WhatsApp CRM — app/api/whatsapp/*) ─────────
# Found in: Meta App Dashboard → WhatsApp → API Setup
WHATSAPP_TOKEN=your-whatsapp-cloud-api-token-here
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id-here
# The GET handshake token you set when configuring the webhook in the Meta
# dashboard (any string you choose, Meta echoes it back once).
WHATSAPP_VERIFY_TOKEN=choose-a-random-verify-token-here
# The app secret (Meta App Dashboard → App settings → Basic → App secret) —
# required to verify inbound webhook signatures (X-Hub-Signature-256).
# Without this set, /api/whatsapp/webhook refuses every inbound message
# rather than trusting an unverified payload — see that route's comments.
WHATSAPP_APP_SECRET=your-meta-app-secret-here

# ─── Groq (used for a couple of WhatsApp reply-suggestion helpers) ───────────
GROQ_API_KEY=your-groq-api-key-here

# ─── Staff birthday reminders (cron: /api/cron/staff-birthdays) ──────────────
# Emails Benny/Tal/Shir 7 days before a staff member's birthday (uses
# RESEND_API_KEY above). The WhatsApp leg to Benny is optional and reuses the
# WHATSAPP_TOKEN / WHATSAPP_PHONE_NUMBER_ID already required by the live
# WhatsApp CRM (app/api/whatsapp/send) — it silently no-ops until all of
# WHATSAPP_TOKEN, WHATSAPP_PHONE_NUMBER_ID, and these two are set:
BIRTHDAY_WHATSAPP_TO=972501234567          # Benny's number — set as a real Vercel env var, not here
BIRTHDAY_TEMPLATE_NAME=birthday_reminder   # still needed: an approved Meta template, {{1}}=name, {{2}}=date

# ─── Gemini (https://aistudio.google.com/apikey) ─────────────────────────────
# Used for: reading every uploaded image/video/PDF — passport photos on trip
# registration, instructor certificates, and the /admin/coordinator/gemini tool.
# See lib/gemini.ts.
GEMINI_API_KEY=your-gemini-api-key-here
# Optional: lets a trusted server call /api/gemini without a Supabase admin
# session, via header "x-api-secret: <this value>".
GEMINI_ROUTE_SECRET=generate-a-random-secret-here

# ─── Notes ────────────────────────────────────────────────────────────────────
# 1. Copy this file to .env.local and fill in real values
# 2. .env.local is git-ignored — never commit secrets
# 3. In production (Vercel/Railway), add these as environment variables in the dashboard
# 4. Rotate SUPABASE_SERVICE_ROLE_KEY if it is ever accidentally exposed
